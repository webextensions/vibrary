# Normalize line endings: store as LF in the repo and check out as LF everywhere.
* text=auto eol=lf

# Shell scripts must always use LF (e.g. husky hooks, health-check / branching scripts).
*.sh text eol=lf

# Treat common binary file types as binary (never normalize / diff as text).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
