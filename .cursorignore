# ======= Custom ignored directories and files =======

# Auto-generated directories
dist
public-*

# Database directories
app-data/database/postgresql
app-data/database/postgresql-backups
app-data/database/sqlite
app-data/database/sqlite-backups

# Secrets files
**/*.secrets.*
!**/*.secrets.example.*

# ======= Generic ignored directories and files =======

# Environment variables files
**/.env
**/.env.*
**/*.env

# Certificate and key files
**/*.crt
**/*.key
**/*.pem

# Archive files
*.tar
*.tar.gz
*.zip

# Backup directories and files
backup
*.backup
*.backup.temp
*.bak

# Log directories and files
logs
*.log

# Temporary directories and files
temp
*.tmp
