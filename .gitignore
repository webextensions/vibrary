# NOTE: This file is edited in the "abstract-javascript-project" branch and flows into the other
# branches via the usual template merges. It is the PRIMARY home for ALL ignore patterns of the
# whole template-branch family - family-wide artifacts (caches, logs, node_modules, ...) AND the
# structure/build output of every branch (public-*, app-data, ...) - so any branch's leftovers stay
# git-invisible after a branch switch, with zero per-clone setup. The SECONDARY escape hatch for
# machine-local personal patterns is .git/info/exclude ("node --run setup:git-exclude"; see
# docs/template-project/git-info-exclude.example). Policy:
# .claude/skills/updating-ignore-rules/SKILL.md.

# Temporary folders
tmp/
temp/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

.cache/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Frontend build output (config-driven publicDirectory - see config/)
/public-*/

# Local configuration files
/config/*.local.js
/config/*.local.secrets.js

# Secrets files
*.secrets.*
!*.secrets.example.*

# Temporary backup files
*.backup.temp

# Encryption keys (config/encryption/ on the web-app family; that family guards them via its
# tracked config/encryption/keys/.gitignore - these lines keep leftovers invisible everywhere)
/config/encryption/keys/*.pem
!/config/encryption/keys/*.documented.runtime.*.pem

# Application data (databases etc.) - web-app family; that family keeps the directory structure
# present via tracked per-directory .gitignore files
/app-data/

# Playwright files
/.playwright-mcp/
