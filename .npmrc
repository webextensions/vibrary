# Skip package versions published less than 3 days ago to mitigate supply chain attacks.
# Requires npm >= 11.10.0; older npm (e.g. the one bundled with the Node 24.2.0 CI engines-floor leg)
# silently ignores this unknown key, so the supply-chain delay is a no-op there.
min-release-age=3

## Skip package scripts (commented out for the time being since it may impact the workflow depending on the use case)
# ignore-scripts=true
