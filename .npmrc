# Skip the automatic vulnerability audit that piggybacks on every "npm install" (a registry
# round-trip); running "npm audit" explicitly still works.
audit=false

# Skip the "packages are looking for funding" notice at the end of installs.
fund=false

# Skip package versions published less than 3 days ago to mitigate supply chain attacks.
# Requires npm >= 11.10.0; older npm versions silently ignore this unknown key, so the
# supply-chain delay is a no-op there.
min-release-age=3

## Skip package scripts (commented out for the time being since it may impact the workflow depending on the use case)
# ignore-scripts=true
