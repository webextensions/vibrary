{
    "name": "runbooks",
    "version": "1.0.0",
    "description": "Browse and edit runbooks (truths / reviews / specs / tasks) XML files in the current folder through a small web UI",
    "type": "module",
    "bin": {
        "runbooks": "./bin/runbooks.js",
        "runbooks-server": "./bin/runbooks-server.js"
    },
    "files": [
        "bin",
        "backend",
        "dist"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build": "vite build --config frontend/vite.config.ts",
        "dev": "vite --config frontend/vite.config.ts",
        "dev:server": "node --watch bin/runbooks-server.js",
        "lint": "eslint .",
        "prepare": "husky || true && node scripts/setup-git-textconv.js",
        "prepack": "npm run build",
        "start": "concurrently \"node --run start:build\" \"node --run start:server\" --prefix \"[{time}] [{index}]\" --timestamp-format \"HH:mm:ss.SSS\"",
        "start:use-hmr": "node --watch-path=./backend --watch-path=./scripts scripts/start-server.js --hmr",
        "start:build": "node --run start:build:do-not-watch",
        "start:build:do-not-watch": "node scripts/start-build.js",
        "start:build:watch": "node scripts/start-build.js --watch",
        "start:server": "node --watch scripts/start-server.js",
        "test": "echo \"Warning: no test specified\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webextensions/runbooks.git"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/webextensions/runbooks/issues"
    },
    "homepage": "https://github.com/webextensions/runbooks#readme",
    "dependencies": {
        "commander": "^15.0.0",
        "compression": "^1.8.1",
        "express": "^5.2.1",
        "get-port": "^7.2.0",
        "glob": "^13.0.6",
        "helpmate": "^1.9.0",
        "ignore": "^7.0.5",
        "open": "^11.0.0",
        "react-syntax-highlighter": "^16.1.1"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.9.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^6.0.2",
        "classnames": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.5.0",
        "eslint-config-ironplate": "^3.0.0",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-n": "^18.1.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-unicorn": "^68.0.0",
        "fast-xml-parser": "^5.9.3",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "node-notifier": "^10.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-draggable": "^4.7.0",
        "react-responsive": "^10.0.1",
        "react-select": "^5.10.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16"
    }
}
