{
    "name": "vibrary",
    "version": "1.0.0",
    "description": "Browse and edit vibrary (reviews / specs / tasks / ideas) XML files in the current folder through a small web UI",
    "type": "module",
    "bin": {
        "vibrary": "./bin/vibrary.js",
        "vibrary-server": "./bin/vibrary-server.js"
    },
    "files": [
        "backend",
        "bin",
        "dist",
        "frontend/src/vibraryXmlCore.js"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "overrides": {
        "node-notifier": {
            "uuid": "^11.1.1"
        }
    },
    "scripts": {
        "build": "vite build --config frontend/vite.config.ts",
        "dev": "vite --config frontend/vite.config.ts",
        "dev:server": "node --watch bin/vibrary-server.js",
        "lint": "eslint .",
        "prepare": "husky || true && node scripts/setup-git-textconv.js",
        "prepack": "node --run lint && node --run typecheck && node --run test && node --run build",
        "start": "concurrently \"node --run start:build\" \"node --run start:server\" --prefix \"[{time}] [{index}]\" --timestamp-format \"HH:mm:ss.SSS\"",
        "start:use-hmr": "node --watch-path=./backend --watch-path=./scripts scripts/start-server.js --hmr",
        "start:build": "node --run start:build:do-not-watch",
        "start:build:do-not-watch": "node scripts/start-build.js",
        "start:build:watch": "node scripts/start-build.js --watch",
        "start:server": "node --watch scripts/start-server.js",
        "test": "node --test \"frontend/src/**/*.test.js\" \"frontend/src/**/*.test.ts\" \"backend/**/*.test.js\" \"scripts/**/*.test.js\"",
        "typecheck": "tsc --noEmit -p frontend && tsc --noEmit -p tsconfig.node.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webextensions/vibrary.git"
    },
    "keywords": [
        "claude",
        "editor",
        "ideas",
        "local",
        "reviews",
        "specs",
        "tasks",
        "xml"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/webextensions/vibrary/issues"
    },
    "homepage": "https://github.com/webextensions/vibrary#readme",
    "dependencies": {
        "commander": "^15.0.0",
        "compression": "^1.8.1",
        "express": "^5.2.1",
        "fast-xml-parser": "^5.9.3",
        "get-port": "^7.2.0",
        "glob": "^13.0.6",
        "ignore": "^7.0.5",
        "open": "^11.0.0",
        "simple-git": "^3.36.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.10.0",
        "@eslint/js": "^10.0.1",
        "@rjsf/core": "^6.6.2",
        "@rjsf/utils": "^6.6.2",
        "@rjsf/validator-ajv8": "^6.6.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^6.0.3",
        "classnames": "^2.5.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.6.0",
        "eslint-config-ironplate": "^3.0.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.2.1",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-unicorn": "^69.0.0",
        "globals": "^17.7.0",
        "helpmate": "^1.9.0",
        "husky": "^9.1.7",
        "node-notifier": "^10.0.1",
        "re-resizable": "^6.11.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-draggable": "^4.7.0",
        "react-responsive": "^10.0.1",
        "react-select": "^5.10.2",
        "react-syntax-highlighter": "^16.1.1",
        "react-toastify": "^11.1.0",
        "streamdown": "^2.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.0"
    }
}
